diff --git a/app/src/main/assets/site/css/style.css b/app/src/main/assets/site/css/style.css
index 29e90e2..e065a81 100644
--- a/app/src/main/assets/site/css/style.css
+++ b/app/src/main/assets/site/css/style.css
@@ -435,3 +435,39 @@ body.ambient-on .scrim { opacity: 0.55; }
 #prefs .row { gap: 18px; flex-shrink: 0; }
 #prefs .row > span { white-space: normal; overflow: visible; }
 #prefs .row b { margin-left: 0; text-align: right; }
+
+/* ---------- app menu & move mode ---------- */
+.app-menu {
+  position: absolute;
+  left: 50%;
+  bottom: 300px;
+  transform: translateX(-50%);
+  min-width: 420px;
+  padding: 22px;
+  border-radius: 22px;
+  background: rgba(10, 14, 28, 0.92);
+  box-shadow: 0 0 0 1px var(--glass-line), 0 18px 48px rgba(0, 0, 0, 0.5);
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+  z-index: 20;
+  direction: rtl;
+}
+.app-menu[hidden] { display: none; }
+.app-menu-title { font-size: 24px; color: var(--fg2); text-align: center; margin-bottom: 6px; }
+.menu-btn {
+  font: inherit;
+  font-size: 26px;
+  color: var(--fg);
+  background: var(--glass);
+  border: 0;
+  border-radius: 14px;
+  padding: 14px 20px;
+  text-align: center;
+}
+.menu-btn.focused { background: #fff; color: var(--ink); }
+.tile.moving {
+  transform: translateY(-14px) scale(1.06);
+  box-shadow: 0 0 0 5px var(--accent), 0 14px 28px rgba(0, 0, 0, 0.35);
+  z-index: 2;
+}
